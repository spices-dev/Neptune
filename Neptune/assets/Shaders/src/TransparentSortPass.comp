/**
* @file TransparentSortPass.comp.
* @brief This Shader Defines TransparentSortPass Compute Shader Behaver.
* @author Spices.
*/

/************************************Pre Compile*******************************************/

#version 460

#extension GL_GOOGLE_include_directive : enable    /* @brief Enable include Macro. */

#include "Header/PreRendererLayout.glsl"

/*****************************************************************************************/

/*************************************Comp Input******************************************/

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/*****************************************************************************************/

/********************************Descriptor List******************************************/

/**
* @brief push constant.
*/
layout(push_constant) uniform Push { uint iter; };
        
struct SortParam
{
    uint stage;
    uint passOfStage;
    uint numElements;
};

/**
* @brief Sort Address.
*/
layout(set = 1, binding = 0) uniform UBO1 { uint64_t sortAddress; };  /* @see Sort */

/**
* @brief SortParam.
*/
layout(set = 1, binding = 1) uniform UBO2 { uint64_t sortParamAddress; };

/**
* @brief Sort Buffer.
*/
layout(buffer_reference, scalar, buffer_reference_align = 8) buffer Sorts
{
    uint64_t i[];             /* @biref Sort list. */
};
Sorts sorts;

/**
* @brief SortParams Buffer.
*/
layout(buffer_reference, scalar, buffer_reference_align = 8) buffer SortParams
{
    SortParam i[];             /* @biref SortParams. */
};
SortParams sortParams;
        
/*****************************************************************************************/

/**********************************Shader Entry*******************************************/

void main()
{
    sorts       = Sorts(sortAddress);
    SortParam p = SortParams(sortParamAddress).i[iter];
    
    uint pairDistance = 1u << (p.stage - p.passOfStage);
    uint blockWidth   = 2u * pairDistance;
    
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.numElements / 2u)
    {
        return;
    }
        
    uint leftId  = (idx % pairDistance) + (idx / pairDistance) * blockWidth;
    uint rightId = leftId + pairDistance;
    
    if (rightId >= p.numElements)
    {
        return;
    }

    uint64_t leftEntry  = sorts.i[leftId];
    uint64_t rightEntry = sorts.i[rightId];
    
    uint leftKey  = uint(leftEntry >> 32);
    uint rightKey = uint(rightEntry >> 32);
        
    bool ascending = ((idx / (1u << p.stage)) % 2u) == 0u;
    //bool needSwap  = ascending ? (leftKey > rightKey) : (leftKey < rightKey);
    bool needSwap  = ascending ? (leftEntry > rightEntry) : (leftEntry < rightEntry);

    if (needSwap)
    {
        sorts.i[leftId]  = rightEntry;
        sorts.i[rightId] = leftEntry;
    }
}

/*****************************************************************************************/