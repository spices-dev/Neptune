/**
* @file TransparentSortPassRadixHistogram.comp.
* @brief This Shader Defines TransparentSorPasstRadixHistogram Compute Shader Behaver.
* @author Spices.
*/

/************************************Pre Compile*******************************************/

#version 460

#extension GL_GOOGLE_include_directive : enable          /* @brief Enable include Macro. */

#include "Header/PreRendererLayout.glsl"
#include "Header/GS3DTileRenderCommon.glsl"

/*****************************************************************************************/

/*************************************Comp Input******************************************/
        
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/*****************************************************************************************/

/********************************Descriptor List******************************************/

/**
* @brief push constant.
*/
layout(push_constant) uniform Push
{
    RadixPush push;
};

shared uint sHist[256];

/*****************************************************************************************/

/**********************************Shader Entry*******************************************/
        
void main()
{
    TileSortInfo info = TileSortInfos(push.infoAddress).i[0];
    uint numElements  = info.numElements;
    uint numWG        = info.numWG;
        
    uint tid = gl_LocalInvocationID.x;
    uint idx = gl_GlobalInvocationID.x;

    sHist[tid] = 0u;
    barrier();

    if (idx < numElements)
    {
        uint digit = uint(TileEntries(push.srcAddress).i[idx] >> push.shift) & 0xFFu;
        atomicAdd(sHist[digit], 1u);
    }
    barrier();

    TileUints(push.histAddress).i[tid * numWG + gl_WorkGroupID.x] = sHist[tid];
}

/*****************************************************************************************/