/**
* @file TransparentSortPassRadixHistogram.comp.
* @brief This Shader Defines TransparentSorPasstRadixHistogram Compute Shader Behaver.
* @author Spices.
*/

/************************************Pre Compile*******************************************/

#version 460

#extension GL_GOOGLE_include_directive : enable          /* @brief Enable include Macro. */

#include "Header/PreRendererLayout.glsl"
#include "Header/GS3DTileRenderCommon.glsl"

/*****************************************************************************************/

/*************************************Comp Input******************************************/
        
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/*****************************************************************************************/

/********************************Descriptor List******************************************/

/**
* @brief push constant.
*/
layout(push_constant) uniform Push
{
    RadixPush push;
};

shared uint sHist[256];

/*****************************************************************************************/

/**********************************Functions**********************************************/

uint Digit(uint64_t e, uint shift)
{
    uvec2 v = unpackUint2x32(e);
    return ((shift < 32u) ? (v.x >> shift) : (v.y >> (shift - 32u))) & 0xFFu;
}

/*****************************************************************************************/
        
/**********************************Shader Entry*******************************************/
        
void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint wg  = gl_WorkGroupID.x;

    TileEntries src  = TileEntries(push.srcAddress);
    uint        base = wg * RADIX_ELEMS_PER_WG + tid;
    const uint  MAXIDX = MAXTILEGAUSSIANS - 1u;
    uint64_t    e0   = src.i[min(base,          MAXIDX)];
    uint64_t    e1   = src.i[min(base + 256u,   MAXIDX)];
    uint64_t    e2   = src.i[min(base + 512u,   MAXIDX)];
    uint64_t    e3   = src.i[min(base + 768u,   MAXIDX)];

    TileSortInfos info = TileSortInfos(push.infoAddress);
    uint numElements   = info.i[0].numElements;
    uint numWG         = info.i[0].numWG;
    
    sHist[tid] = 0u;
    barrier();

    uint shift = push.shift;
    if (base            < numElements) atomicAdd(sHist[Digit(e0, shift)], 1u);
    if (base + 256u     < numElements) atomicAdd(sHist[Digit(e1, shift)], 1u);
    if (base + 512u     < numElements) atomicAdd(sHist[Digit(e2, shift)], 1u);
    if (base + 768u     < numElements) atomicAdd(sHist[Digit(e3, shift)], 1u);

    barrier();

    TileUints(push.histAddress).i[tid * numWG + wg] = sHist[tid];
}

/*****************************************************************************************/