/**
* @file TransparentSortPassRadixScan.comp.
* @brief This Shader Defines TransparentSortPassRadixScan Compute Shader Behaver.
* @author Spices.
*/

/************************************Pre Compile*******************************************/

#version 460

#extension GL_GOOGLE_include_directive : enable    /* @brief Enable include Macro. */

#include "Header/PreRendererLayout.glsl"
#include "Header/GS3DTileRenderCommon.glsl"

/*****************************************************************************************/

/*************************************Comp Input******************************************/

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

/*****************************************************************************************/

/********************************Descriptor List******************************************/

/**
* @brief push constant.
*/
layout(push_constant) uniform Push
{
    uint64_t srcAddress;
    uint64_t dstAddress;
    uint64_t histAddress;
    uint64_t infoAddress;
    uint     shift;
};

shared uint sSum[256];

/*****************************************************************************************/

/**********************************Shader Entry*******************************************/
        
void main()
{
    uint numWG = TileSortInfo(infoAddress).numWG;
        
    uint tid   = gl_LocalInvocationID.x;
    uint digit = gl_WorkGroupID.x;

    TileUints h = TileUints(histAddress);
    uint base   = digit * numWG;
        
    uint perThread = (numWG + 255u) / 256u;
    uint begin     = min(tid * perThread, numWG);
    uint end       = min(begin + perThread, numWG);

    uint local = 0u;
    for (uint i = begin; i < end; ++i) local += h.i[base + i];

    sSum[tid] = local;
    barrier();
        
    for (uint off = 1u; off < 256u; off <<= 1u)
    {
        uint v = (tid >= off) ? sSum[tid - off] : 0u;
        barrier();
        sSum[tid] += v;
        barrier();
    }
        
    uint running = sSum[tid] - local;
    for (uint i = begin; i < end; ++i)
    {
        uint v = h.i[base + i];
        h.i[base + i] = running;
        running += v;
    }
        
    if (tid == 255u) h.i[256u * numWG + digit] = sSum[255];
}

/*****************************************************************************************/