/**
* @file GS3DProjection.slangh.
* @brief This Shader Header File Defines GS3DProjection Functions.
* @author Spices.
*/

/************************************Pre Compile*******************************************/
        
#ifndef GS3D_PROJECTION_H
#define GS3D_PROJECTION_H

#include "Core.h"
#include "PreRendererLayout.slangh"

/*****************************************************************************************/

/**************************************Constant*******************************************/

static const float kGSMaxRadiusRatio    = 0.35f;
static const float kDistanceScaleCutOff = 0.05f;

/*****************************************************************************************/

/******************************************Functions**************************************/

/**
* @brief Transform Quaterion to Matrix.
*
* @param[in] q Quaterion.
*
* @return Returns Matrix.
*/
float3x3 QuatToMat3(float4 q)
{
    float x = q.x, y = q.y, z = q.z, w = q.w;

     return float3x3(
            float3(1.0 - 2.0*(y*y + z*z), 2.0*(x*y - w*z),       2.0*(x*z + w*y)      ),
            float3(2.0*(x*y + w*z),       1.0 - 2.0*(x*x + z*z), 2.0*(y*z - w*x)      ),
            float3(2.0*(x*z - w*y),       2.0*(y*z + w*x),       1.0 - 2.0*(x*x + y*y)));
}

/**
* @brief Calculate Gassian Project.
* 
* @param[in] p Position.
* @param[in] s Scale.
* @param[in] q Quaterion.
* @param[out] clipPos .
* @param[out] viewPos .
* @param[out] conic .
* @param[out] majorAxis .
* @param[out] r1 .
* @param[out] minorAxis .
* @param[out] r2 .
* @param[out] radius .
*
* @return Returns true if visible.
*/
bool ProjectGaussian(float3 p, float3 s, float4 q,
    out float4 clipPos, out float4 viewPos, out float3 conic, 
    out float2 majorAxis, out float r1,
    out float2 minorAxis, out float r2, 
    out float radius
){
    viewPos = mul(view.view, float4(p, 1.0));
    clipPos = mul(view.projection, viewPos);

    conic     = float3(0.0); 
    majorAxis = float2(1,0); 
    minorAxis = float2(0,1);
    
    r1     = 0.0; 
    r2     = 0.0; 
    radius = 0.0;

    if (viewPos.z <= 0.01) return false;
            
    // Distance Cutoff.
    float ms = max(s.x, max(s.y, s.z));
    if (ms < kDistanceScaleCutOff && ms * 1000.0f < viewPos.z) return false;

    float3x3 R     = QuatToMat3(q);
    float3x3 S     = float3x3(s.x,0,0, 0,s.y,0, 0,0,s.z);
    float3x3 Sigma = mul(mul(mul(R, S), S), transpose(R));

    float3x3 W   = (float3x3)view.view;
    float focalX = view.projection[0][0] * (view.sceneTextureSize.x * 0.5);
    float focalY = view.projection[1][1] * (view.sceneTextureSize.y * 0.5);

    float invZ  = 1.0 / viewPos.z;
    float invZ2 = invZ * invZ;
    float3x3 J = float3x3(focalX * invZ, 0.0,          -focalX * viewPos.x * invZ2,
                          0.0,           focalY * invZ, -focalY * viewPos.y * invZ2,
                          0.0,           0.0,            0.0);

    float3x3 T   = mul(J, W);
    float3x3 cov = mul(mul(T, Sigma), transpose(T));
    
    cov[0][0] += 0.3; 
    cov[1][1] += 0.3;

    float a = cov[0][0];
    float b = cov[0][1];
    float c = cov[1][1];
    
    float det = a * c - b * b;
    if (det <= 0.0) return false;

    float mid     = 0.5 * (a + c);
    float lambda1 = mid + sqrt(max(0.1, mid * mid - det));
    float lambda2 = mid - sqrt(max(0.1, mid * mid - det));
    radius        = ceil(3.0 * sqrt(max(lambda1, lambda2)));
    
    float maxRadius = kGSMaxRadiusRatio * min(view.sceneTextureSize.x, view.sceneTextureSize.y);
    if (!(radius > 0.0 && radius <= maxRadius)) return false;
    
    float2 ndc  = clipPos.xy / clipPos.w;
    float2 pix  = (ndc * 0.5 + 0.5) * view.sceneTextureSize.xy;
    if (pix.x < -radius || pix.x > view.sceneTextureSize.x + radius ||
        pix.y < -radius || pix.y > view.sceneTextureSize.y + radius) return false;

    float invDet   = 1.0 / det;
    conic          = float3(c * invDet, -b * invDet, a * invDet);

    float disc     = sqrt(max(mid * mid - det, 0.0));
    float lambdaT  = mid + disc;
    float2  ev     = (a >= c) ? float2(lambdaT - c, b) : float2(b, lambdaT - a);
    float evLen2   = dot(ev, ev);
    majorAxis      = (evLen2 > 1e-20) ? ev * rsqrt(evLen2) : float2(1.0, 0.0);
    minorAxis      = float2(-majorAxis.y, majorAxis.x);

    r1             = max(3.0 * sqrt(max(lambda1, 0.0)), 1.0);
    r2             = max(3.0 * sqrt(max(lambda2, 0.0)), 1.0);

    return true;
}

/*****************************************************************************************/

#endif